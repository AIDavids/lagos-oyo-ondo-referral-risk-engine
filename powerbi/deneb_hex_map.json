{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Hexagon tile map: one hexagon per LGA, Lagos | Oyo | Ondo side by side. Click a hexagon to filter the report.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "params": [
    {
      "name": "hexSize",
      "value": 1000
    }
  ],
  "data": {
    "name": "dataset"
  },
  "transform": [
    {
      "calculate": "datum.state_name === 'Lagos' ? 0 : (datum.state_name === 'Oyo' ? 8.5 : 15.5)",
      "as": "xoff"
    },
    {
      "calculate": "(datum.tile_col - 1) + datum.xoff + ((datum.tile_row % 2) === 0 ? 0.5 : 0)",
      "as": "gx"
    },
    {
      "calculate": "(datum.tile_row - 1) * 0.866",
      "as": "gy"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "point",
        "shape": "M0,-1L0.866,-0.5L0.866,0.5L0,1L-0.866,0.5L-0.866,-0.5Z",
        "filled": true,
        "size": {
          "expr": "hexSize"
        },
        "strokeWidth": 2,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "gx",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.7,
              20.7
            ]
          },
          "axis": null
        },
        "y": {
          "field": "gy",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.3,
              6.37
            ],
            "reverse": true
          },
          "axis": null
        },
        "color": {
          "field": "action_label",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Add public clinics",
              "Contract private clinics",
              "No action now"
            ],
            "range": [
              "#B4281E",
              "#E8B4AF",
              "#C9D3D8"
            ]
          }
        },
        "stroke": {
          "condition": {
            "test": "datum.action_label === 'Contract private clinics'",
            "value": "#B4281E"
          },
          "value": "#FFFFFF"
        },
        "opacity": {
          "condition": {
            "test": "datum['__selected__'] === 'off'",
            "value": 0.35
          },
          "value": 1
        },
        "tooltip": [
          {
            "field": "lga_name",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "action_label",
            "type": "nominal",
            "title": "Recommended action"
          },
          {
            "field": "pop_per_public_phc",
            "type": "quantitative",
            "title": "People per public clinic",
            "format": ",.0f"
          },
          {
            "field": "phc_deficit",
            "type": "quantitative",
            "title": "Public clinics needed",
            "format": ",.0f"
          },
          {
            "field": "confidence",
            "type": "nominal",
            "title": "Confidence"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Segoe UI",
        "fontSize": 8.5,
        "fontWeight": "bold",
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "gx",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.7,
              20.7
            ]
          },
          "axis": null
        },
        "y": {
          "field": "gy",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.3,
              6.37
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "tile_label",
          "type": "nominal"
        },
        "color": {
          "condition": [
            {
              "test": "datum.action_label === 'Add public clinics'",
              "value": "#FFFFFF"
            },
            {
              "test": "datum.action_label === 'Contract private clinics'",
              "value": "#7A1F18"
            }
          ],
          "value": "#33474F"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 3.25,
            "y": -0.8,
            "t": "Lagos"
          },
          {
            "x": 11.25,
            "y": -0.8,
            "t": "Oyo"
          },
          {
            "x": 17.75,
            "y": -0.8,
            "t": "Ondo"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Georgia",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#0B2530"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.7,
              20.7
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.3,
              6.37
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false
    }
  }
}