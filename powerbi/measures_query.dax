// Paste into Power BI Desktop > DAX query view. Needs the table _Measures to exist first (Home > Enter data > blank, name it _Measures).
// Click Run: the result row should show LGAs Assessed 71, LGAs Short 31, Add 23, Contract 8, Hidden Gaps 24.
// Then click "Update model with changes" (above the DEFINE block) to add all measures to the model.
// Rank Value is not here: it needs the "Rank By" table. Create that table, then add Rank Value from the bottom of this file.

DEFINE
  MEASURE _Measures[LGAs Assessed] = COUNTROWS(mart_lga_decision)
  MEASURE _Measures[LGAs Short] = CALCULATE(COUNTROWS(mart_lga_decision), mart_lga_decision[public_deficit] = TRUE())
  MEASURE _Measures[Add LGAs] = CALCULATE(COUNTROWS(mart_lga_decision), mart_lga_decision[action_label] = "Add public clinics")
  MEASURE _Measures[Contract LGAs] = CALCULATE(COUNTROWS(mart_lga_decision), mart_lga_decision[action_label] = "Contract private clinics")
  MEASURE _Measures[No Action LGAs] = CALCULATE(COUNTROWS(mart_lga_decision), mart_lga_decision[action_label] = "No action now")
  MEASURE _Measures[Hidden Gaps] = CALCULATE(COUNTROWS(mart_lga_decision), mart_lga_decision[h1_case] = TRUE())
  MEASURE _Measures[Range Low] = MAX(mart_kpis[lgas_short_if_unknown_public])
  MEASURE _Measures[Population Total] = SUM(mart_lga_decision[population_2025])
  MEASURE _Measures[People In Short LGAs] = CALCULATE(SUM(mart_lga_decision[population_2025]), mart_lga_decision[public_deficit] = TRUE())
  MEASURE _Measures[Pct People Short] = DIVIDE([People In Short LGAs], [Population Total])
  MEASURE _Measures[Clinics Needed] = SUM(mart_lga_decision[phc_deficit])
  MEASURE _Measures[Pct Clinics Beyond 15km] = MAX(mart_kpis[pct_clinics_beyond_15km])
  MEASURE _Measures[Median Distance Km] = MAX(mart_kpis[median_referral_km])
  MEASURE _Measures[Headline] = FORMAT([LGAs Short], "0") & " of " & FORMAT([LGAs Assessed], "0") & " LGAs have too few public clinics."
  MEASURE _Measures[Subheadline] = FORMAT([Add LGAs], "0") & " need more public clinics. " & FORMAT([Contract LGAs], "0") & " can use private clinics already in place."
  MEASURE _Measures[Range Text] = "Range: " & FORMAT([Range Low], "0") & " to " & FORMAT([LGAs Short], "0") & " if unknown owners count as public"
  MEASURE _Measures[Selected LGA ID] = VAR picked = SELECTEDVALUE(mart_lga_decision[lga_id])
    VAR top1 = CALCULATE(MAX(mart_lga_decision[lga_id]), ALL(mart_lga_decision), mart_lga_decision[severity_rank] = 1)
    RETURN COALESCE(picked, top1)
  MEASURE _Measures[Selected LGA] = VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[lga_name]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
  MEASURE _Measures[Selected State] = VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[state_name]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
  MEASURE _Measures[Selected Action] = VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[action_label]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
  MEASURE _Measures[Selected People Per Clinic] = VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[pop_per_public_phc]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
  MEASURE _Measures[Selected Public Clinics] = VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[phc_public]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
  MEASURE _Measures[Selected Clinics Missing] = VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[phc_deficit]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
  MEASURE _Measures[Selected Median Km] = VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[median_referral_km]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
  MEASURE _Measures[Selected Robust] = VAR sel = [Selected LGA ID] RETURN IF(CALCULATE(COUNTROWS(mart_lga_decision), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel, mart_lga_decision[robust_top10] = TRUE()) > 0, " ★ Robust", "")
  MEASURE _Measures[Confidence Text] = VAR sel = [Selected LGA ID]
    VAR r = CALCULATETABLE(mart_lga_decision, ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
    RETURN "Confidence: " & MAXX(r, mart_lga_decision[confidence]) & " · " & MAXX(r, mart_lga_decision[settings_same]) & " of " & MAXX(r, mart_lga_decision[settings_total]) & " data checks"
  MEASURE _Measures[Action Fill] = SWITCH([Selected Action], "Add public clinics", "#B4281E", "Contract private clinics", "#B4281E", "#DDE5E9")
  MEASURE _Measures[Action Text Color] = SWITCH([Selected Action], "Add public clinics", "#FFFFFF", "Contract private clinics", "#FFFFFF", "#33474F")
  MEASURE _Measures[Profile Sentence] = [Selected LGA] & " has " & FORMAT([Selected Public Clinics], "0") & " public clinics: one per " & FORMAT([Selected People Per Clinic], "#,0") & " people. The target is one per 10,000."
  MEASURE _Measures[Candidates Available] = VAR sel = [Selected LGA ID] RETURN CALCULATE(SUM(mart_candidate_cover[candidates_available]), ALL(mart_lga_decision), mart_candidate_cover[lga_id] = sel)
  MEASURE _Measures[Cover Ratio] = VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_candidate_cover[cover_ratio]), ALL(mart_lga_decision), mart_candidate_cover[lga_id] = sel)
  MEASURE _Measures[Cover Label] = VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_candidate_cover[cover_label]), ALL(mart_lga_decision), mart_candidate_cover[lga_id] = sel)
  MEASURE _Measures[Cover Text] = IF(ISBLANK([Cover Ratio]), "No candidates", FORMAT([Candidates Available], "0") & " vs " & FORMAT([Selected Clinics Missing], "0") & " needed: " & [Cover Label] & " (" & FORMAT([Cover Ratio], "0.00") & "x)")
  MEASURE _Measures[Same Action Flag] = VAR a = MAX(mart_scenarios[action])
    VAR b = MAX(mart_lga_decision[action_low])
    RETURN IF(a = b, 1, 0)
  MEASURE _Measures[Tile Label] = MAX(dim_lga_tile[lga_label])
  MEASURE _Measures[Tile Fill] = SWITCH(MAX(mart_lga_decision[action_label]), "Add public clinics", "#B4281E", "Contract private clinics", "#FFFFFF", "#DDE5E9")
  MEASURE _Measures[Tile Text Color] = SWITCH(MAX(mart_lga_decision[action_label]), "Add public clinics", "#FFFFFF", "Contract private clinics", "#B4281E", "#33474F")

EVALUATE ROW("LGAs Assessed", [LGAs Assessed], "LGAs Short", [LGAs Short], "Add", [Add LGAs], "Contract", [Contract LGAs], "Hidden Gaps", [Hidden Gaps], "Selected LGA", [Selected LGA], "Selected Action", [Selected Action])

