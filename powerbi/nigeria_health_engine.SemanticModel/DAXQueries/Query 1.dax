// Paste into DAX query view, Run, then "Update model with changes". New measures only.
DEFINE
  MEASURE _Measures[Rule 1 Short] = VAR lid = [Selected LGA ID] VAR ppc = [Selected People Per Clinic] VAR far = COALESCE(CALCULATE(MAX(mart_lga_decision[pct_phc_beyond_15km]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = lid), 0) RETURN "1. Critical gap? " & FORMAT(ppc, "#,0") & " per clinic, " & FORMAT(far, "0%") & " far: " & IF(ppc > 15000 && far >= 0.5, "YES", "no")
  MEASURE _Measures[Rule 2 Short] = VAR ppc = [Selected People Per Clinic] VAR med = [Selected Median Km] RETURN "2. Ambulance gap? Median " & FORMAT(med, "0.0") & " km to a hospital: " & IF(ppc <= 10000 && med > 20, "YES", "no")
  MEASURE _Measures[Rule 3 Short] = VAR lid = [Selected LGA ID] VAR ppc = [Selected People Per Clinic] VAR priv = COALESCE(CALCULATE(MAX(mart_lga_decision[private_share]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = lid), 0) RETURN "3. Contract? " & FORMAT(ppc, "#,0") & " per clinic, " & FORMAT(priv, "0%") & " private: " & IF(ppc > 12000 && priv >= 0.65, "YES", "no")
  MEASURE _Measures[Rule 4 Short] = VAR ppc = [Selected People Per Clinic] RETURN "4. Add public clinics? " & FORMAT(ppc, "#,0") & " per clinic: " & IF(ppc > 10000, "YES", "no")
  MEASURE _Measures[Result Short] = "Result: " & [Selected Action]
  MEASURE _Measures[Same Count] = VAR base = MAX(mart_lga_decision[action_low]) RETURN COALESCE(COUNTROWS(FILTER(mart_scenarios, mart_scenarios[action] = base)), 0)
  MEASURE _Measures[Stability Label] = VAR c = [Same Count] RETURN SWITCH(TRUE(), c = 18, "Robust", c >= 12, "Mostly stable", c >= 6, "Sensitive", "Fragile")

EVALUATE ROW("Rule 1", [Rule 1 Short], "Result", [Result Short], "Same count", [Same Count])
