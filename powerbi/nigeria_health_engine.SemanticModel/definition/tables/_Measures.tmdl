		formatString: 0
		lineageTag: 08eb88d6-2572-4e7d-8d0a-60926d840f96

	measure 'Contract LGAs' = ```
			COALESCE(CALCULATE(COUNTROWS(mart_lga_decision), mart_lga_decision[action_label] = "Contract private clinics"), 0)
			  
