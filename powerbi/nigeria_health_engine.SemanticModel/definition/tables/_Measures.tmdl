	measure 'People In Short LGAs' = ```
			COALESCE(CALCULATE(SUM(mart_lga_decision[population_2025]), mart_lga_decision[public_deficit] = TRUE()), 0)
			  
			```
		lineageTag: 12cd9626-24f3-48b7-b291-32a3812eae40

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pct People Short' = ```
			DIVIDE([People In Short LGAs], [Population Total])
			  
			```
		lineageTag: fd846456-d1b7-453d-bd16-9530be80386f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

