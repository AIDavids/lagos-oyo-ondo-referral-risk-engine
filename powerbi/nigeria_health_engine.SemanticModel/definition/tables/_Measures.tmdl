	measure 'Candidates Available' = ```
			VAR sel = [Selected LGA ID] RETURN CALCULATE(SUM(mart_candidate_cover[candidates_available]), ALL(mart_lga_decision), mart_candidate_cover[lga_id] = sel)
			  
