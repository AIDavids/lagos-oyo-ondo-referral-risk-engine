	measure 'People KPI Text' = ```
			VAR n = [LGAs Assessed] VAR s = [LGAs Short] VAR v = IF(n = 1, SUM(mart_lga_decision[population_2025]), [People In Short LGAs]) RETURN SWITCH(TRUE(), n = 0, "-", n > 1 && s = 0, "None", v >= 1000000, FORMAT(v / 1000000, "0.00") & " million", FORMAT(v, "#,0"))
			  
			```
		lineageTag: e25ba6c7-97bb-49dc-8a1e-8bd2fb2984ff

	measure 'Clinics Needed Text' = ```
			VAR n = [LGAs Assessed] VAR c = [Clinics Needed] RETURN IF(c = 0, IF(n = 1, "None: enough clinics", "None needed"), FORMAT(c, "#,0"))
			  
			```
		lineageTag: d85758b7-d7c9-448e-98be-d26e23bcf280

	measure 'Hidden Gaps Title' = ```
			IF([LGAs Assessed] = 1, "Hidden gap? (looks fine if private clinics are counted)", "Hidden gaps (short LGAs that look fine if private clinics are counted)")
			  
			```
		lineageTag: f2823b46-b1fa-4612-a340-52e14eac55be

	measure 'Beyond15 Scope Text' = ```
			VAR tot = CALCULATE(COUNTROWS(fact_facility), fact_facility[facility_level] = "Primary") VAR far = CALCULATE(COUNTROWS(fact_facility), fact_facility[facility_level] = "Primary", fact_facility[referral_km] > 15) RETURN IF(tot = 0, "-", FORMAT(DIVIDE(far, tot), "0.0%"))
			  
			```
		lineageTag: f4d88568-d615-47f9-8fd2-4fb26c4019ad

	measure 'Scope Line' = ```
			VAR total = CALCULATE(COUNTROWS(mart_lga_decision), ALL(mart_lga_decision), ALL(mart_state_summary)) VAR n = [LGAs Assessed] RETURN SWITCH(TRUE(), n = 1, "Showing one LGA: " & [Selected LGA Title] & ". Click the same hexagon again to clear.", n < total && ISFILTERED(mart_lga_decision[state_name]), "Showing: " & CONCATENATEX(VALUES(mart_lga_decision[state_name]), mart_lga_decision[state_name], ", ") & ". Use the State filter on the left to change.", n < total, "Showing " & FORMAT(n, "0") & " selected LGAs.", "Showing all three states. Range: " & FORMAT([Range Low], "0") & " to " & FORMAT([LGAs Short], "0") & " LGAs are short if unknown owners count as public.")
			
			
			```
		lineageTag: 3c2c15d0-0d59-49a2-995b-cd2309d0f27b

	measure 'Beyond15 Display' = ```
			VAR tot = COALESCE(CALCULATE(COUNTROWS(fact_facility), fact_facility[facility_level] = "Primary"), 0) VAR far = COALESCE(CALCULATE(COUNTROWS(fact_facility), fact_facility[facility_level] = "Primary", fact_facility[referral_km] > 15), 0) RETURN IF(tot = 0, "No clinics listed", FORMAT(DIVIDE(far, tot), "0.0%"))
			  
			```
		lineageTag: bdde559a-b11a-49a1-8cf6-ac8eee00e0e6

	measure 'Profile Context Line' = ```
			VAR lid = [Selected LGA ID] VAR pop = CALCULATE(MAX(mart_lga_decision[population_2025]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = lid) VAR dens = CALCULATE(MAX(mart_lga_decision[pop_density_km2]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = lid) RETURN "Population " & FORMAT(pop, "#,0") & " · " & FORMAT(DIVIDE(pop, dens), "#,0") & " km² · " & FORMAT(dens, "#,0") & " people per km²"
			
			
			```
		lineageTag: 67daa694-1c1b-493b-acb5-e5bc3303d311

	measure 'Rule 1 Short' = ```
