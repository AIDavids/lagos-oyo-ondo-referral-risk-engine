	measure 'PPC Rank Text' = ```
			VAR sel = [Selected People Per Clinic] RETURN "#" & FORMAT(COUNTROWS(FILTER(ALL(mart_lga_decision), mart_lga_decision[pop_per_public_phc] > sel)) + 1, "0") & " of " & FORMAT(COUNTROWS(ALL(mart_lga_decision)), "0")
			  
			```
		lineageTag: 242109db-3774-462d-a46d-9da3353b140f

	measure 'Missing Rank Text' = ```
			VAR sel = [Selected Clinics Missing] RETURN "#" & FORMAT(COUNTROWS(FILTER(ALL(mart_lga_decision), mart_lga_decision[phc_deficit] > sel)) + 1, "0") & " of " & FORMAT(COUNTROWS(ALL(mart_lga_decision)), "0")
			  
			```
		lineageTag: 7d447440-6c65-4a94-90d6-3c51cc0b2e06

	measure 'Rule 1 Text' = ```
			VAR lid = [Selected LGA ID] VAR ppc = [Selected People Per Clinic] VAR far = CALCULATE(MAX(mart_lga_decision[pct_phc_beyond_15km]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = lid) RETURN "1. Over 15,000 people per clinic and half or more of clinics 15+ km from a hospital: " & IF(ppc > 15000 && far >= 0.5, "YES", "no") & " (" & FORMAT(ppc, "#,0") & " per clinic, " & FORMAT(far, "0%") & " far)"
			  
			```
		lineageTag: eef5914a-c6e0-403b-b97e-9fe4b9d5ecc4

	measure 'Rule 2 Text' = ```
			VAR ppc = [Selected People Per Clinic] VAR med = [Selected Median Km] RETURN "2. Up to 10,000 per clinic but median hospital distance over 20 km: " & IF(ppc <= 10000 && med > 20, "YES", "no") & " (median " & FORMAT(med, "0.0") & " km)"
			  
			```
		lineageTag: 98f97fb9-4cc5-4ce7-be8a-a1c65e6ee632

	measure 'Rule 3 Text' = ```
			VAR lid = [Selected LGA ID] VAR ppc = [Selected People Per Clinic] VAR priv = CALCULATE(MAX(mart_lga_decision[private_share]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = lid) RETURN "3. Over 12,000 per clinic and 65% or more of clinics private: " & IF(ppc > 12000 && priv >= 0.65, "YES", "no") & " (" & FORMAT(priv, "0%") & " private)"
			  
			```
		lineageTag: dd8c5f8a-359b-42db-b01f-0b46c9456afe

	measure 'Rule 4 Text' = ```
