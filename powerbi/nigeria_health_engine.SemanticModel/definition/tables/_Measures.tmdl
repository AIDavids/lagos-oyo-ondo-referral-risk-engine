table _Measures
	lineageTag: 8aa13bc5-0a5a-4c1c-8718-884d65c74a50

	measure 'LGAs Assessed' = ```
			COUNTROWS(mart_lga_decision)
			  
			```
		formatString: 0
		lineageTag: 0ef67d12-fd0e-45af-86a2-6ade37202558

	measure 'LGAs Short' = ```
			COALESCE(CALCULATE(COUNTROWS(mart_lga_decision), mart_lga_decision[public_deficit] = TRUE()), 0)
			  
			```
		formatString: 0
		lineageTag: 3c228147-8046-43c3-a302-f268a3d7a5ad

	measure 'Add LGAs' = ```
			COALESCE(CALCULATE(COUNTROWS(mart_lga_decision), mart_lga_decision[action_label] = "Add public clinics"), 0)
			  
			```
		formatString: 0
		lineageTag: 08eb88d6-2572-4e7d-8d0a-60926d840f96

	measure 'Contract LGAs' = ```
			COALESCE(CALCULATE(COUNTROWS(mart_lga_decision), mart_lga_decision[action_label] = "Contract private clinics"), 0)
			  
			```
		formatString: 0
		lineageTag: 854832d0-6305-4c21-b05e-8e5f671c703f

	measure 'No Action LGAs' = ```
			COALESCE(CALCULATE(COUNTROWS(mart_lga_decision), mart_lga_decision[action_label] = "No action now"), 0)
			  
			```
		formatString: 0
		lineageTag: 27a379c4-b1c5-4f82-93d3-72a8f4aa5eb2

	measure 'Hidden Gaps' = ```
			COALESCE(CALCULATE(COUNTROWS(mart_lga_decision), mart_lga_decision[h1_case] = TRUE()), 0)
			  
			```
		formatString: 0
		lineageTag: e16a4fa8-b4e9-4f48-a175-44353543f222

	measure 'Range Low' = ```
			MAX(mart_kpis[lgas_short_if_unknown_public])
			  
			```
		formatString: 0
		lineageTag: 1bc4e85d-0f01-472d-9d19-db7e02d41c9e

	measure 'Population Total' = ```
			SUM(mart_lga_decision[population_2025])
			  
			```
		lineageTag: 533b23c7-9783-486e-8080-42628662ea1e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'People In Short LGAs' = ```
			COALESCE(CALCULATE(SUM(mart_lga_decision[population_2025]), mart_lga_decision[public_deficit] = TRUE()), 0)
			  
			```
		lineageTag: 12cd9626-24f3-48b7-b291-32a3812eae40

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pct People Short' = ```
			DIVIDE([People In Short LGAs], [Population Total])
			  
			```
		lineageTag: fd846456-d1b7-453d-bd16-9530be80386f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Clinics Needed' = ```
			COALESCE(SUM(mart_lga_decision[phc_deficit]), 0)
			  
			```
		formatString: 0
		lineageTag: d49327c4-1851-409e-9236-c0e4f788ca2b

	measure 'Pct Clinics Beyond 15km' = ```
			MAX(mart_kpis[pct_clinics_beyond_15km])
			  
			```
		lineageTag: 04f7efe2-bc1d-480f-b15c-0de9509472e1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Distance Km' = ```
			MAX(mart_kpis[median_referral_km])
			  
			```
		lineageTag: e41e928e-ccca-4bf9-a18d-fd2f89c1c153

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Headline = ```
			VAR n = [LGAs Assessed] VAR s = [LGAs Short] RETURN SWITCH(TRUE(), n = 1, IF(s = 1, "This LGA has too few public clinics.", "This LGA has enough public clinics."), s = 0, "All " & FORMAT(n, "0") & " LGAs have enough public clinics.", FORMAT(s, "0") & " of " & FORMAT(n, "0") & " LGAs have too few public clinics.")
			  
			```
		lineageTag: c59df381-65f8-4047-83a3-4bc94544b8b8

	measure Subheadline = ```
			SWITCH(TRUE(), [LGAs Assessed] = 1, IF([LGAs Short] = 1, "Recommended action: " & [Selected Action] & ".", "No action needed now."), [LGAs Short] = 0, "No LGA in this selection needs action now.", FORMAT([Add LGAs], "0") & " need more public clinics. " & FORMAT([Contract LGAs], "0") & " can use private clinics already in place.")
			  
			```
		lineageTag: fa47f445-c25c-478d-a826-e3c68317b030

	measure 'Range Text' = ```
			IF([LGAs Assessed] < CALCULATE(COUNTROWS(mart_lga_decision), ALL(mart_lga_decision), ALL(mart_state_summary)), "", "Range: " & FORMAT([Range Low], "0") & " to " & FORMAT([LGAs Short], "0") & " if unknown owners count as public")
			  
			```
		lineageTag: f0cf4433-c10e-4e85-a9ad-6f3d66fd1997

	measure 'Selected LGA ID' = ```
			VAR picked = SELECTEDVALUE(mart_lga_decision[lga_id])
			    VAR top1 = CALCULATE(MAX(mart_lga_decision[lga_id]), ALL(mart_lga_decision), mart_lga_decision[severity_rank] = 1)
			    RETURN COALESCE(picked, top1)
			  
			```
		lineageTag: a9764b02-50bb-471c-ab7d-15fe935d638c

	measure 'Selected LGA' = ```
			VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[lga_name]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
			  
			```
		lineageTag: ce0de9e4-6853-4a7e-ac25-a905625ba3d3

	measure 'Selected State' = ```
			VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[state_name]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
			  
			```
		lineageTag: 8e34fed3-ba7a-46cb-a285-6cb9b5eae036

	measure 'Selected Action' = ```
			VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[action_label]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
			  
			```
		lineageTag: f63ffad7-209b-40db-81bb-d9cd9c1aef6f

	measure 'Selected People Per Clinic' = ```
			VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[pop_per_public_phc]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
			  
			```
		lineageTag: 59c209ee-dbdc-4064-bb9f-1b2a620dc828

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Public Clinics' = ```
			VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[phc_public]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
			  
			```
		formatString: 0
		lineageTag: 9754d0e8-203d-4bc9-8c3d-f1cad0c5ce7a

	measure 'Selected Clinics Missing' = ```
			VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[phc_deficit]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
			  
			```
		formatString: 0
		lineageTag: bbd971ea-52ce-4aae-898f-f61a00c2b27d

	measure 'Selected Median Km' = ```
			VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_lga_decision[median_referral_km]), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
			  
			```
		lineageTag: f77a7e63-3ab6-487f-909e-60b8e92f1250

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Robust' = ```
			VAR sel = [Selected LGA ID] RETURN IF(CALCULATE(COUNTROWS(mart_lga_decision), ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel, mart_lga_decision[robust_top10] = TRUE()) > 0, " ★ Robust", "")
			  
			```
		lineageTag: 371511d8-7830-4f6e-baf8-ea674ef3f3da

	measure 'Confidence Text' = ```
			VAR sel = [Selected LGA ID]
			    VAR r = CALCULATETABLE(mart_lga_decision, ALL(mart_lga_decision), mart_lga_decision[lga_id] = sel)
			    RETURN "Confidence: " & MAXX(r, mart_lga_decision[confidence]) & " · " & MAXX(r, mart_lga_decision[settings_same]) & " of " & MAXX(r, mart_lga_decision[settings_total]) & " data checks"
			  
			```
		lineageTag: c1b17f4f-948d-432b-9606-9ee4780a5e7f

	measure 'Action Fill' = ```
			SWITCH([Selected Action], "Add public clinics", "#B4281E", "Contract private clinics", "#B4281E", "#DDE5E9")
			  
			```
		lineageTag: b4060ef7-e418-4cb0-ace8-fe437ab5c7ef

	measure 'Action Text Color' = ```
			SWITCH([Selected Action], "Add public clinics", "#FFFFFF", "Contract private clinics", "#FFFFFF", "#33474F")
			  
			```
		lineageTag: 5205af85-dbe9-42a4-a0ca-c366f59400d1

	measure 'Profile Sentence' = ```
			[Selected LGA] & " has " & FORMAT([Selected Public Clinics], "0") & " public clinics: one per " & FORMAT([Selected People Per Clinic], "#,0") & " people. The target is one per 10,000."
			  
			```
		lineageTag: cd3eab16-a1c6-4304-b914-478aba3183ec

	measure 'Candidates Available' = ```
			VAR sel = [Selected LGA ID] RETURN CALCULATE(SUM(mart_candidate_cover[candidates_available]), ALL(mart_lga_decision), mart_candidate_cover[lga_id] = sel)
			  
			```
		formatString: 0
		lineageTag: 83bc0344-69d2-4db1-bf08-71b74fc2d989

	measure 'Cover Ratio' = ```
			VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_candidate_cover[cover_ratio]), ALL(mart_lga_decision), mart_candidate_cover[lga_id] = sel)
			  
			```
		lineageTag: c61fabe4-8965-4259-a22c-7b5aab85cd47

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cover Label' = ```
			VAR sel = [Selected LGA ID] RETURN CALCULATE(MAX(mart_candidate_cover[cover_label]), ALL(mart_lga_decision), mart_candidate_cover[lga_id] = sel)
			  
			```
		lineageTag: 16128a53-507d-42b6-a2e3-dc0f0e885cff

	measure 'Cover Text' = ```
			IF(ISBLANK([Cover Ratio]), "No candidates", FORMAT([Candidates Available], "0") & " vs " & FORMAT([Selected Clinics Missing], "0") & " needed: " & [Cover Label] & " (" & FORMAT([Cover Ratio], "0.00") & "x)")
			  
			```
		lineageTag: 67907ce7-99af-465f-8d8a-28f54d2b1d66

	measure 'Same Action Flag' = ```
			VAR a = MAX(mart_scenarios[action])
			    VAR b = MAX(mart_lga_decision[action_low])
			    RETURN IF(a = b, 1, 0)
			  
			```
		formatString: 0
		lineageTag: f37c964e-2075-4af3-813d-1e6e697ddbae

	measure 'Tile Label' = ```
			IF(HASONEVALUE(dim_lga_tile[tile_col]) && HASONEVALUE(dim_lga_tile[tile_row]), MAX(dim_lga_tile[tile_label]))
			  
			```
		lineageTag: cb18e581-9eb9-48b2-80e4-3e140bd3c331

	measure 'Tile Fill' = ```
			IF(ISBLANK([Tile Label]), "#FFFFFF", SWITCH(MAX(mart_lga_decision[action_label]), "Add public clinics", "#B4281E", "Contract private clinics", "#E8B4AF", "#C9D3D8"))
			  
			```
		lineageTag: 2615857c-d82c-42c4-87d2-91676f2c675a

	measure 'Tile Text Color' = ```
			IF(ISBLANK([Tile Label]), "#FFFFFF", SWITCH(MAX(mart_lga_decision[action_label]), "Add public clinics", "#FFFFFF", "Contract private clinics", "#7A1F18", "#33474F"))
			
			
			```
		lineageTag: eb853c84-d5cc-496e-8694-4a12b6b54a32

	measure 'Hidden Gaps Text' = ```
			FORMAT([Hidden Gaps], "0") & " of " & FORMAT([LGAs Short], "0")
			  
			```
		lineageTag: 6ba0717b-2b0b-422c-b890-0c1253630237

	measure 'Pct Beyond15 Text' = ```
			FORMAT([Pct Clinics Beyond 15km], "0.0%")
			  
			```
		lineageTag: 327fa2c7-7660-4eca-bf87-ce36c508a307

	measure 'Selected LGA Title' = ```
			[Selected LGA] & ", " & [Selected State]
			  
			```
		lineageTag: 349ce04c-394b-4608-9f7b-955ed7b7311f

	column Column1
