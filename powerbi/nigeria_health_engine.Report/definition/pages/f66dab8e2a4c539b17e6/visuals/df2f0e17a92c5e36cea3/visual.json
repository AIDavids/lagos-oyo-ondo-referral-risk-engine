        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "The target is an assumption",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.0pt",
                      "color": "#0B2530",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "1 public clinic per 10,000 people is the low end of national guidance for a Primary Health Centre (10,000 to 20,000 people). We count every primary-level facility, so gaps may be understated.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8.2pt",
                      "color": "#0B2530"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Why these three states",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.0pt",
                      "color": "#0B2530",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Chosen for contrast: Lagos is metropolitan (20 LGAs), Oyo is mixed (33), Ondo is smaller and more rural or coastal (18). All are in the South West and have enough registered facilities to analyse. This is a chosen sample, not a random one: the findings apply to these three states only.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8.2pt",
                      "color": "#0B2530"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
